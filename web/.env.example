# Подключение к PostgreSQL.
# Локально своя база, на Railway подставляется из переменной сервиса Postgres.
DATABASE_URL="postgresql://user:password@localhost:5432/opion?schema=public"

# Полный адрес сайта. На Railway: https://${{RAILWAY_PUBLIC_DOMAIN}}
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Адрес мини-аппа, если с сайта нужна ссылка на него.
NEXT_PUBLIC_MINI_APP_URL=

# --- Приём заказов -----------------------------------------------------------
# Токен бота из @BotFather.
TELEGRAM_BOT_TOKEN=
# Группа, куда бот присылает заказы. У групп идентификатор отрицательный.
TELEGRAM_ORDERS_CHAT_ID=

# --- Реквизиты для перевода --------------------------------------------------
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_HOLDER=
PAYMENT_BANK=
