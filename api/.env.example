# База данных. На Railway подставляется ссылкой ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:password@localhost:5432/opion?schema=public"

# Адрес API для браузера. На Railway: https://${{RAILWAY_PUBLIC_DOMAIN}}
PUBLIC_API_URL="http://localhost:4000"

# Домены, которым разрешено обращаться к API из браузера, через запятую.
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# --- Приём заказов -----------------------------------------------------------
# Токен бота из @BotFather.
TELEGRAM_BOT_TOKEN=
# Группа, куда бот присылает заказы. У групп идентификатор отрицательный.
TELEGRAM_ORDERS_CHAT_ID=
# Топик форума внутри группы. Пусто, если тем нет.
TELEGRAM_ORDERS_THREAD_ID=
# Секрет вебхука: этим же значением вызывается setWebhook у бота.
TELEGRAM_WEBHOOK_SECRET=
# Адрес мини-аппа: его бот даёт кнопкой в ответ на /start.
# На Railway: https://${{app.RAILWAY_PUBLIC_DOMAIN}}
MINI_APP_URL="http://localhost:3001"

# --- Хранилище картинок ------------------------------------------------------
# Бакет Railway. На Railway подставляется ссылками ${{opion-media.BUCKET}} и т.д.
BUCKET_NAME=
BUCKET_ENDPOINT=
BUCKET_REGION=auto
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=

# --- Реквизиты для перевода --------------------------------------------------
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_HOLDER=
PAYMENT_BANK=

# --- Первый вход в админку ------------------------------------------------
# Из этих переменных сид заводит владельца. После первого входа пароль
# меняется в разделе «Команда», а переменные можно убрать.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=
