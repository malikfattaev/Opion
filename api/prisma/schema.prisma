// Схема базы данных OPIØN.
// Документация: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Откуда пришёл заказ: витрина, мини-апп или занесли руками из админки.
enum OrderSource {
  WEBSITE
  MINI_APP
  MANUAL
}

enum OrderStatus {
  /// Оплата пришла, основатели ещё не посмотрели.
  NEW
  /// Перевод сверили, заказ собирается.
  CONFIRMED
  /// Передан в доставку.
  SHIPPED
  /// Покупатель получил заказ.
  DONE
  /// Перевод не сошёлся или заказ отменили.
  REJECTED
}

model Order {
  id String @id @default(cuid())

  /// Сквозной номер заказа. Последовательность ведёт база, поэтому два
  /// одновременных заказа не могут получить один номер.
  seq Int @unique @default(autoincrement())

  source OrderSource
  status OrderStatus @default(NEW)

  firstName String
  lastName  String
  phone     String
  address   String
  comment   String?

  /// Сумма на момент оформления: каталог потом может подорожать.
  total Int

  /// Покупатель из мини-аппа, подтверждённый подписью Telegram.
  telegramUserId   String?
  telegramUsername String?

  /// Секрет для покупателя с сайта: профиля нет, статус смотрим по ссылке.
  publicToken String @unique

  /// Сообщение с заказом в группе основателей, чтобы обновлять его кнопки.
  telegramChatId    String?
  telegramMessageId Int?

  /// Кто нажал «Подтвердить» или «Отклонить» в группе.
  decidedByName String?
  decidedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([status, createdAt])
  @@index([telegramUserId, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String

  /// Ссылка на каталог по slug: товар могут переименовать, заказ не должен меняться.
  productSlug String
  name        String
  size        String
  quantity    Int
  unitPrice   Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}
